/*
 * Generated by CMake from src/version.cpp.in; the copy in the build tree is not the one to
 * edit. The version is declared once, by project() in the top level CMakeLists.txt, and
 * reaches the sources from there. It used to be written out by hand in version.cpp, which is
 * how that file came to say 1.0.0 while the project declared 1.1.0.
 */
#define VERSION_STR "@PROJECT_VERSION@"
#define VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define VERSION_MINOR @PROJECT_VERSION_MINOR@
#define VERSION_RELEA @PROJECT_VERSION_PATCH@
